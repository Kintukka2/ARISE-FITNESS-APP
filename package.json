{
  "name": "arise-fitness",
  "private": true,
  "version": "6.0.0",
  "type": "module",
  "description": "ARISE: a Solo-Leveling-style fitness RPG for the phone.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node e2e/smoke.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "android": "npm run build && npx cap sync android",
    "balance": "node scripts/run.mjs scripts/balance.ts",
    "calibrate": "node scripts/run.mjs scripts/calibrate.ts"
  },
  "dependencies": {
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
